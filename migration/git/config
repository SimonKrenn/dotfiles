[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[user]
	name = Simon Krenn
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKOZCQsHAYrEv2BzBLelFzdSX9aVx0sgXZBxdhS9Ojam
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[delta]
  navigate = true
[merge]
  conflictStyle = zdiff3
[rerere]
	enabled = true

[merge]
  tool = codediff
[mergetool "codediff"]
  cmd = "nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\""
[diff]
  tool = codediff
[difftool "codediff"]
  cmd = "nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\""
[include]
  path = ~/.config/git/local.gitconfig
